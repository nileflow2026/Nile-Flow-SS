# ── Backend API ───────────────────────────────────────────────────
VITE_API_BASE_URL=https://nile-flow-backend-5dqm.onrender.com
VITE_API_TIMEOUT=30000
VITE_API_RETRY_COUNT=3
VITE_API_RETRY_DELAY=1000

# ── Token Storage ─────────────────────────────────────────────────
# Options: memory | localStorage | sessionStorage
# memory = most secure (XSS-resistant), lost on refresh
# localStorage = persists across sessions (use with "remember me")
VITE_TOKEN_STORAGE=memory

# ── Application ───────────────────────────────────────────────────
VITE_LOCALE=en
VITE_CURRENCY=KES

# ── Cache ─────────────────────────────────────────────────────────
VITE_CACHE_STALE_TIME=300000
VITE_CACHE_GC_TIME=600000

# ── Currency ──────────────────────────────────────────────────────
# Override default KES base if needed

# ── Feature Flags ─────────────────────────────────────────────────
VITE_ENABLE_OAUTH=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_WEBSOCKETS=false
VITE_ENABLE_DEBUG_LOGGING=false

# ── Monitoring ────────────────────────────────────────────────────
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_LOG_LEVEL=warn

# ── OAuth ─────────────────────────────────────────────────────────
VITE_GOOGLE_REDIRECT_URI=
VITE_FACEBOOK_REDIRECT_URI=

# ── Payments ──────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MPESA_POLL_INTERVAL=3000
VITE_MPESA_POLL_MAX_DURATION=120000

# ── WebSocket ─────────────────────────────────────────────────────
VITE_WS_URL=

# ── Upload ────────────────────────────────────────────────────────
VITE_MAX_UPLOAD_SIZE=5242880
