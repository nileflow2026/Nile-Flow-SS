{
  "name": "NileFlowAfrica",
  "main": "expo-router/entry",
  "version": "2.5.25",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "ota:validate:staging": "npx --yes eas-cli@24.12.1 env:exec preview \"node scripts/validate-ota-environment.js\" --non-interactive",
    "ota:validate:production": "npx --yes eas-cli@24.12.1 env:exec production \"node scripts/validate-ota-environment.js\" --non-interactive",
    "ota:staging": "npx --yes eas-cli@24.12.1 update --channel staging --environment preview",
    "ota:production": "npx --yes eas-cli@24.12.1 update --channel production --environment production",
    "postandroid": "node ./scripts/fix-netinfo-paths.js",
    "postprebuild": "node ./scripts/fix-netinfo-paths.js",
    "translate:check": "node ./scripts/sync-translations.js --check",
    "translate:sync": "node ./scripts/sync-translations.js"
  },
